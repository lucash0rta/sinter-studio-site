---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Sinter Studio", description = "Melbourne based digital design studio." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Space+Grotesk:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="preload" href="/fonts/ZTNature-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/ZTNature-Bold.otf" as="font" type="font/otf" crossorigin />
    <!-- Block flash of wrong theme -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.style.visibility = "hidden";
        document.addEventListener("DOMContentLoaded", function () {
          document.body.dataset.theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.style.visibility = "";
        });
      })();
    </script>
    <style is:global>@import "../styles/global.css";</style>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="page">
      <slot />
    </div>

    <!-- Project overlay modal -->
    <div id="project-modal" class="pmodal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="pmodal-title">
      <div class="pmodal__backdrop"></div>
      <div class="pmodal__panel">
        <div class="pmodal__media">
          <video id="pmodal-video" autoplay muted loop playsinline style="display:none">
            <source id="pmodal-video-src" src="" type="video/mp4" />
          </video>
          <img id="pmodal-img" src="" alt="" style="display:none" />
        </div>
        <div class="pmodal__info">
          <button class="pmodal__close" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </button>
          <h2 id="pmodal-title" class="pmodal__title"></h2>
          <dl id="pmodal-meta" class="pmodal__meta"></dl>
          <p id="pmodal-summary" class="pmodal__summary"></p>
          <a id="pmodal-link" href="#" class="text-link pmodal__link">View full project →</a>
        </div>
      </div>
    </div>

    <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (window.matchMedia('(hover: none)').matches) return;
      var glow = document.querySelector('.cursor-glow');
      if (!glow) return;
      var tx = window.innerWidth / 2, ty = window.innerHeight / 2;
      var cx = tx, cy = ty;
      var raf = null;
      function tick() {
        cx += (tx - cx) * 0.18;
        cy += (ty - cy) * 0.18;
        glow.style.setProperty('--cx', cx + 'px');
        glow.style.setProperty('--cy', cy + 'px');
        if (Math.abs(tx - cx) > 0.4 || Math.abs(ty - cy) > 0.4) {
          raf = requestAnimationFrame(tick);
        } else {
          raf = null;
        }
      }
      window.addEventListener('pointermove', function (e) {
        tx = e.clientX; ty = e.clientY;
        glow.classList.add('is-active');
        if (raf == null) raf = requestAnimationFrame(tick);
      }, { passive: true });
      window.addEventListener('pointerleave', function () {
        glow.classList.remove('is-active');
      });
    })();
    </script>

    <script is:inline>
    (function () {
      var modal = document.getElementById('project-modal');
      var videoEl = document.getElementById('pmodal-video');
      var videoSrc = document.getElementById('pmodal-video-src');
      var imgEl = document.getElementById('pmodal-img');
      var titleEl = document.getElementById('pmodal-title');
      var metaEl = document.getElementById('pmodal-meta');
      var summaryEl = document.getElementById('pmodal-summary');
      var linkEl = document.getElementById('pmodal-link');
      var closeBtn = modal.querySelector('.pmodal__close');
      var backdrop = modal.querySelector('.pmodal__backdrop');
      var lastFocused = null;

      function openModal(data) {
        lastFocused = document.activeElement;
        var isVideo = data.mediaType === 'video';
        videoEl.style.display = isVideo ? 'block' : 'none';
        imgEl.style.display = isVideo ? 'none' : 'block';

        if (isVideo && data.coverUrl) {
          videoSrc.setAttribute('type', data.coverUrl.endsWith('.webm') ? 'video/webm' : 'video/mp4');
          videoSrc.src = data.coverUrl;
          videoEl.load();
          videoEl.play().catch(function(){});
        } else if (data.coverUrl) {
          imgEl.src = data.coverUrl;
          imgEl.alt = data.title || '';
        }

        titleEl.textContent = data.title || '';

        var memberName = data.member === 'rory' ? 'Rory Henderson'
          : data.member === 'lucas' ? 'Lucas Horta'
          : data.member === 'claude' ? 'Claude Zhang'
          : data.member === 'both' ? 'Lucas Horta & Rory Henderson'
          : data.member === 'lucas_claude' ? 'Lucas Horta & Claude Zhang'
          : data.member === 'rory_claude' ? 'Rory Henderson & Claude Zhang'
          : data.member === 'all' ? 'Lucas Horta, Rory Henderson & Claude Zhang'
          : null;

        var rows = [];
        if (data.client) rows.push(['Client', data.client]);
        if (data.year) rows.push(['Year', String(data.year)]);
        if (memberName) rows.push(['Member', memberName]);
        if (data.roles && data.roles.length) rows.push(['Roles', data.roles.join(', ')]);
        if (data.credits && data.credits.length) {
          data.credits.forEach(function(credit) {
            var name = credit.url
              ? '<a class="text-link" href="' + credit.url + '" target="_blank" rel="noreferrer">' + credit.name + '</a>'
              : credit.name;
            rows.push([credit.role, name]);
          });
        }
        if (data.tags && data.tags.length) rows.push(['Tags', data.tags.join(', ')]);

        metaEl.innerHTML = rows.map(function(r) {
          return '<div><dt>' + r[0] + '</dt><dd>' + r[1] + '</dd></div>';
        }).join('');

        summaryEl.textContent = data.summary || '';
        summaryEl.style.display = data.summary ? 'block' : 'none';
        linkEl.href = '/projects/' + data.slug;

        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        setTimeout(function() { closeBtn.focus(); }, 50);
      }

      function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        videoEl.pause();
        if (lastFocused) lastFocused.focus();
      }

      document.querySelectorAll('[data-project]').forEach(function(card) {
        card.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function(e) {
            e.preventDefault();
            var data = JSON.parse(card.dataset.project);
            openModal(data);
          });
        });
      });

      closeBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', closeModal);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
      });
    })();
    </script>

    <script>
      const apply = (theme: string) => {
        document.body.dataset.theme = theme;
        localStorage.setItem("theme", theme);
      };
      const stored = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      apply(stored || (prefersDark ? "dark" : "light"));

      document.addEventListener("click", (e) => {
        const toggle = (e.target as HTMLElement).closest(".theme-toggle") as HTMLElement | null;
        if (!toggle) return;
        const next = document.body.dataset.theme === "dark" ? "light" : "dark";
        toggle.classList.remove("is-animating");
        void toggle.offsetWidth;
        toggle.classList.add("is-animating");
        apply(next);
      });
      document.addEventListener("animationend", (e) => {
        (e.target as HTMLElement).closest?.(".theme-toggle")?.classList?.remove("is-animating");
      });
    </script>
  </body>
</html>
